# Copy to '.env' and update for local or production use.

# Backend REST API Endpoint
VITE_API_URL=http://localhost:5050/api
VITE_BASE_URL=http://localhost:5050

# Application Metadata
VITE_APP_NAME="School ERP - Multi-School SaaS Platform"
VITE_PORT=5173

# Dedicated Portals (Local vs Production Render URLs)
# Local Defaults:
VITE_TEACHER_URL=http://localhost:5177
VITE_ACCOUNTANT_URL=http://localhost:5178
VITE_ADMIN_URL=http://localhost:5176
VITE_SUPERADMIN_URL=http://localhost:5179
VITE_BRANCH_URL=http://localhost:5174
VITE_STUDENT_URL=http://localhost:5175
VITE_DRIVER_URL=http://localhost:5180

